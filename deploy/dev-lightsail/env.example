# TEMPORARY dev setup: settings for the dev server, kept in /srv/helpdesk/.env on the server
# (never in Git). setup-server.sh creates that file from this template and fills in the generated
# passwords and key; set-site-password.sh sets the dev password. Change the rest by hand.

# The dev site's address. Workspaces are its subdomains (acme.dev.helpdesk.example.com).
HELPDESK_DOMAIN=dev.helpdesk.example.com
APP_PUBLIC_URL=https://dev.helpdesk.example.com

# Set by deploy.sh on each deploy: the Git commit that is running.
APP_VERSION=

# Database passwords: generated by setup-server.sh, used only inside the server.
POSTGRES_PASSWORD=
MIGRATOR_DB_PASSWORD=
APP_DB_PASSWORD=
READONLY_DB_PASSWORD=

# Two-step verification secrets key (openssl rand -base64 32): generated by setup-server.sh.
# Replacing it makes existing two-step verification setups unreadable.
TWO_FACTOR_ENCRYPTION_KEY=

# The shared dev password of the test mailbox (set with set-site-password.sh).
SITE_USER=helpdesk
SITE_PASSWORD_HASH=

# Email: smtp sends everything to the test mailbox (mail.<HELPDESK_DOMAIN>).
# ses sends for real through Amazon SES, but only to EMAIL_ALLOWED_RECIPIENTS; everyone else's
# email still goes to the test mailbox. ses needs a send-only key in AWS_* below.
EMAIL_DRIVER=smtp
# System email's address; the product name (src/product.ts) is added as the sender name.
EMAIL_FROM=noreply@example.com
# Domain of every workspace's own email address (F13). Dev email lands in the test mailbox.
TICKET_EMAIL_DOMAIN=in.dev.helpdesk.example.com
# Real email to workspace addresses: SES receiving saves it in this bucket; read it with
# INBOUND_EMAIL_DRIVER=mailpit,s3.
INBOUND_EMAIL_BUCKET=helpdesk-dev-inbound-email
INBOUND_EMAIL_DRIVER=mailpit,s3
EMAIL_ALLOWED_RECIPIENTS=
SES_REGION=ap-south-1
SES_CONFIGURATION_SET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
