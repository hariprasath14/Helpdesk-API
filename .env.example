# helpdesk-api settings. Copy to .env for local development: cp .env.example .env
# On AWS these come from SSM Parameter Store (/helpdesk/<env>/api/<NAME>), never from a file.
# Every variable is validated at startup (src/config); the app refuses to start if one is invalid.

# --- Server ---
# 127.0.0.1 keeps the local API off your network; containers on AWS use the default 0.0.0.0.
HOST=127.0.0.1
PORT=4000
# Set by the pipeline to the release tag or commit; shown in /health and every log line.
APP_VERSION=local

# --- Logging ---
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# json (AWS) | pretty (local only; needs dev dependencies)
LOG_FORMAT=pretty

# --- HTTP security ---
# true when running behind the AWS load balancer, so client IPs come from X-Forwarded-For.
TRUST_PROXY=false
# Comma-separated browser origins allowed to call the API with cookies (exact match, no trailing slash).
CORS_ORIGINS=http://localhost:5173
# Default rate limit per client IP: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
# Largest accepted request body in bytes (uploads get their own limit later).
BODY_LIMIT_BYTES=1048576

# --- API docs ---
# Interactive docs at http://localhost:4000/docs and the OpenAPI spec at /docs/json.
# true locally and in dev (office/VPN only); false in prod.
API_DOCS_ENABLED=true

# --- Database (one database per environment, always two connections) ---
# Writer: helpdesk_app role. On AWS: the Aurora writer endpoint (written to SSM by CDK).
DATABASE_URL=postgres://helpdesk_app:app_local_only@127.0.0.1:5432/helpdesk
# Reader: helpdesk_readonly role. Locally the same database; on AWS the Aurora reader endpoint.
DATABASE_READ_URL=postgres://helpdesk_readonly:readonly_local_only@127.0.0.1:5432/helpdesk
# Schema owner, used only by npm run db:migrate / db:seed (never by the running app).
DATABASE_MIGRATION_URL=postgres://helpdesk_migrator:migrator_local_only@127.0.0.1:5432/helpdesk
# TLS to the database: false only for the local Docker database.
DATABASE_SSL=false
# DATABASE_SSL_CA_FILE=/app/certs/rds-global-bundle.pem
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- App address and sign-in ---
# The address people open; each workspace is a subdomain of it (http://acme.localhost:5173).
# Locally this is the Vite dev server, which forwards /api to this API. On AWS: https://<domain>.
APP_PUBLIC_URL=http://localhost:5173
# Secure (HTTPS-only) sign-in cookie: false only for local http.
COOKIE_SECURE=false
# A sign-in ends after this many hours without activity, and in any case after this many days.
SESSION_IDLE_HOURS=8
SESSION_ABSOLUTE_DAYS=7
# Encrypts authenticator secrets for two-step verification: 32 random bytes, base64.
# This value is for local development only. Every AWS environment gets its own, generated with
# openssl rand -base64 32 and stored in SSM as a SecureString.
TWO_FACTOR_ENCRYPTION_KEY=8nUKH3FjM6Vhnmwp8uLQ4TOla6yzMzkjW4vWbk+f91g=
# Check new passwords against known breaches (Have I Been Pwned, k-anonymity). false = offline.
PASSWORD_BREACH_CHECK=true

# --- Email ---
# smtp (Mailpit locally; every email lands in http://localhost:8025) or ses (Amazon SES API;
# credentials from the AWS SDK: the ECS task role on AWS, or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY).
EMAIL_DRIVER=smtp
EMAIL_FROM=Helpdesk <no-reply@helpdesk.local>
# Domain of every workspace's own email address (acme@TICKET_EMAIL_DOMAIN): ticket email goes out
# from it and customer replies come back to it. Locally everything lands in Mailpit.
TICKET_EMAIL_DOMAIN=mail.helpdesk.local
# Email to workspace addresses becomes tickets (F14), comma separated: mailpit = the worker picks
# it up from Mailpit every INBOUND_POLL_SECONDS; s3 = real email SES receiving saved in
# INBOUND_EMAIL_BUCKET; none = off.
INBOUND_EMAIL_DRIVER=mailpit
MAILPIT_API_URL=http://127.0.0.1:8025
INBOUND_POLL_SECONDS=10
INBOUND_EMAIL_MAX_MB=25
# For s3 (real email): the bucket, key prefix and region SES receiving writes to.
# INBOUND_EMAIL_BUCKET=
# INBOUND_EMAIL_PREFIX=inbound/
# INBOUND_EMAIL_REGION=ap-south-1
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# For ses:
# SES_REGION=ap-south-1
# SES_CONFIGURATION_SET=
# Dev safety list: when set, only these addresses (name@x.com or @x.com, comma separated) get real
# email through EMAIL_DRIVER; everyone else's goes to SMTP (the test mailbox). Empty in prod.
# EMAIL_ALLOWED_RECIPIENTS=

# --- Files ---
# local (a folder on this machine, git-ignored). s3 arrives at Step 0b.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Largest attachment, in MB (at most 50).
ATTACHMENT_MAX_MB=20
